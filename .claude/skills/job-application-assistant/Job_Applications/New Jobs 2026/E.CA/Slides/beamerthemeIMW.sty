% Define framecounterheight variable depending on authorinfott and titleinfoot
\newcommand{\framecounterheight}{0.05}
\ifbeamer@unibielefeld@authorinfoot\ifbeamer@unibielefeld@titleinfoot
    \renewcommand{\framecounterheight}{0.025}
\fi\fi

% Overwrite logo and mylogo with just mylogo (Default is the IMW logo)
\ifbeamer@unibielefeld@logoinfoot\ifbeamer@unibielefeld@mylogoinfoot
    \beamer@unibielefeld@logoinfootfalse
\fi\fi

% Overwrite authorinfoot and mylogo with just authorinfoot
\ifbeamer@unibielefeld@mylogoinfoot\ifbeamer@unibielefeld@authorinfoot
    \beamer@unibielefeld@mylogoinfootfalse
\fi\fi

% Overwrite authorinfoot and logo with just authorinfoot
\ifbeamer@unibielefeld@logoinfoot\ifbeamer@unibielefeld@authorinfoot
    \beamer@unibielefeld@logoinfootfalse
\fi\fi

% Define place mylogo template 
\defbeamertemplate*{place mylogo}{IMW theme}{
    \ifdefempty{\mylogopath}{
        \draw (0.15\paperwidth, 0.05\paperheight) node[fill=body.bg, scale=0.58] {\institutelogo};
        }{
        \IfFileExists{\mylogopath}{
            \draw (0.15\paperwidth, 0.05\paperheight) node[fill=body.bg] {\includegraphics[height=0.07\paperheight]{\mylogopath}};
            }{}
        }
}

% Define place logo template (default is the faculty logo)
\defbeamertemplate*{place logo}{IMW theme}{
    \ifdefempty{\logopath}{
        \draw (0.15\paperwidth, 0.05\paperheight) node[fill=body.bg, scale=0.50] {\departmentlogo};
        }{
        \IfFileExists{\logopath}{
            \draw (0.15\paperwidth, 0.05\paperheight) node[fill=body.bg] {\includegraphics[height=0.07\paperheight]{\logopath}};
            }{}
        }
}

% Create footline template
\defbeamertemplate*{footline}{IMW theme}{
    \ifnum \theframenumber=1
    \else
    \usebeamercolor{structure}
    \usebeamercolor{body}
    
    \begin{tikzpicture}
        % Draw helpline to span the footer
        \draw [draw=body.bg] (0,0) -- (0,0.05\paperheight);

        % Draw line in footer if footerline is true
        \ifbeamer@unibielefeld@footerline
            \draw [draw=structure] (0,0.05\paperheight) -- (0.999\paperwidth,0.05\paperheight);
        \fi
        % Draw framenumber with or without the total frame number
        \ifbeamer@unibielefeld@totalframes
            \draw (0.85\paperwidth, \framecounterheight\paperheight) node[fill=body.bg] {\,\insertframenumber \,/\,\inserttotalframenumber\,};
        \else
            \draw (0.85\paperwidth, \framecounterheight\paperheight) node[fill=body.bg] {\,\insertframenumber\,};
        \fi
        
        % Place the logo if wanted
        \ifbeamer@unibielefeld@logoinfoot
            \usebeamertemplate{place logo}
        \fi
        \ifbeamer@unibielefeld@mylogoinfoot
            \usebeamertemplate{place mylogo}
        \fi

        % Place title if wanted
        \ifbeamer@unibielefeld@titleinfoot
            \draw (0.5\paperwidth, 0.025\paperheight) node[fill=body.bg] {\usebeamerfont{title in head/foot}\insertshorttitle};
        \fi

        % Place author if wanted
        % This is done last s.t. if the safeguard above fails the author names are on top
        \ifbeamer@unibielefeld@authorinfoot
            \draw (0.15\paperwidth, 0.025\paperheight) node[fill=body.bg] {\usebeamerfont{author in head/foot}\insertshortauthor};
        \fi
    \end{tikzpicture}
    \fi
}



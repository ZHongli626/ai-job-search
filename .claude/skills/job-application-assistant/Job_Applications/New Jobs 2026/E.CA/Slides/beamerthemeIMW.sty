\newcommand{\institutelogoheight}{0.12}
\ifdefstring{\beamer@unibielefeld@institutelang}{none}{
  \renewcommand{\institutelogoheight}{0.09}
}{}

\newcommand{\institutelogo}{
  \includegraphics[height=\institutelogoheight\paperheight]{
    logos/institutes/\beamer@unibielefeld@institute/\beamer@unibielefeld@institute_logo_\beamer@unibielefeld@institutelang
  }
}


\newcommand{\departmentlogoheight}{0.2}
\ifdefstring{\beamer@unibielefeld@departmentlang}{none}{
  \renewcommand{\departmentlogoheight}{0.08}
  \ExecuteOptionsBeamer{department=none}
}{}

\ifdefstring{\beamer@unibielefeld@department}{none}{
  \renewcommand{\departmentlogoheight}{0.08}
}{}

\newcommand{\departmentlogo}{
  \includegraphics[height=\departmentlogoheight\paperheight]{
    logos/departments/\beamer@unibielefeld@department/\beamer@unibielefeld@department_logo_\beamer@unibielefeld@departmentlang
  }
}

\ifbeamer@unibielefeld@cudelogo
  \ExecuteOptionsBeamer{institute=CUDE}
\fi

\ifbeamer@unibielefeld@bigsemlogo
  \ExecuteOptionsBeamer{institute=BiGSEM}
\fi
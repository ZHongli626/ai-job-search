%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Modification of Blocks %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Define new conditional
\newif\ifbeamer@unibielefeld@showtitle

% Create command to initilalize the appropriate colors
\newcommand{\beamer@unibielefeld@colorini}[1][]{
  \usebeamercolor{block body#1} 
  \colorlet{beamer@unibielefeld@bodybg}{block body#1.bg}
  \colorlet{beamer@unibielefeld@bodyfg}{block body#1.fg}
  \usebeamercolor{block title#1}
  \colorlet{beamer@unibielefeld@titlebg}{block title#1.bg}
  \colorlet{beamer@unibielefeld@titlefg}{block title#1.fg}
  \usebeamercolor{normal text}
}

% Set global tcolorbox spacing
\tcbsetforeverylayer{
  left=0.5mm,
  right=0.5mm,
  enhanced,
  top=1.5mm,
  bottom=0.5mm,
  clip upper,
}

\ifbeamer@unibielefeld@shadow
  \tcbsetforeverylayer{drop fuzzy shadow=black!90!structure}
\fi

% Definition of blocks
\newtcolorbox{beamer@unibielefeld@block}[1][]{
    code={
        \beamer@unibielefeld@colorini[#1]
        \ifx\insertblocktitle\@empty
          \beamer@unibielefeld@showtitlefalse
        \else
          \beamer@unibielefeld@showtitletrue
          \tcbset{title=\insertblocktitle}
        \fi
    },
    % Create own frame
    frame hidden,
    frame code={
      \ifbeamer@unibielefeld@rounded
        \draw [rounded corners=\cornerarc,draw=beamer@unibielefeld@titlebg,line width=2pt] ([xshift=0.3mm,yshift=-0.3mm]frame.north west) rectangle ([xshift=-0.3mm,yshift=0.3mm]frame.south east);
      \else
        \draw [sharp corners,draw=beamer@unibielefeld@titlebg,line width=2pt] ([xshift=0.3mm,yshift=-0.3mm]frame.north west) rectangle ([xshift=-0.3mm,yshift=0.3mm]frame.south east);
      \fi
    },
    % Create appropriate title corners
    title code={
      \ifbeamer@unibielefeld@rounded
        \fill [fill=beamer@unibielefeld@titlebg] {[rounded corners=\cornerarc] (title.south west) -- (title.north west) -- (title.north east)} -- (title.south east) -- cycle;
      \else
        \fill [fill=beamer@unibielefeld@titlebg] (title.north west) rectangle (title.south east);
      \fi
    },
    % Create appropriate interior corners for titled and untitled blocks
    interior titled code={
      \ifbeamer@unibielefeld@rounded
        \fill [fill=beamer@unibielefeld@bodybg] {[rounded corners=\cornerarc] (interior.north west) -- (interior.south west) -- (interior.south east)} -- (interior.north east) -- cycle;
      \else
        \fill [fill=beamer@unibielefeld@bodybg] (interior.north west) rectangle (interior.south east)
      \fi
    },
    interior code={
      \ifbeamer@unibielefeld@rounded
        \fill [fill=beamer@unibielefeld@bodybg] {[rounded corners=\cornerarc] (interior.north west) -- (interior.south west) -- (interior.south east)} -- (interior.north east) -- cycle;
      \else
        \fill [fill=beamer@unibielefeld@bodybg] (interior.north west) rectangle (interior.south east)
      \fi
    },
    colback=beamer@unibielefeld@bodybg,
    colbacktitle=beamer@unibielefeld@titlebg,
    coltext=beamer@unibielefeld@bodyfg,
    coltitle=beamer@unibielefeld@titlefg,
    before title={\usebeamerfont{block title}},
    before upper={\usebeamercolor{block body}\usebeamerfont{block body}},
    titlerule=0mm,
}

\ifbeamer@unibielefeld@blocks
  \setbeamertemplate{block begin}{\begin{beamer@unibielefeld@block}} 
  \setbeamertemplate{block end}{\end{beamer@unibielefeld@block}}
  \setbeamertemplate{block alerted begin}{\begin{beamer@unibielefeld@block}[ alerted]} 
  \setbeamertemplate{block alerted end}{\end{beamer@unibielefeld@block}}
  \setbeamertemplate{block example begin}{\begin{beamer@unibielefeld@block}[ example]} 
  \setbeamertemplate{block example end}{\end{beamer@unibielefeld@block}}
\fi



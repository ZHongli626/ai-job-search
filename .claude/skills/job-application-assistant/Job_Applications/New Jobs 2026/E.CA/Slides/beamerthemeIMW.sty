%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Define `bubbles` option and style %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Set `compress` to true for the potential headline
\beamer@compresstrue

% Define Headline template
\defbeamertemplate{headline}{IMW theme bubbles}{
  % Define appropriate fonts and colors
  \usebeamerfont*{headline}
  \usebeamercolor{section in head/foot}

  \ifnum\theframenumber=1
    % Put box in `white` on the first page.
    \begin{beamercolorbox}[ht=2.25ex,dp=3.75ex]{white}
    \end{beamercolorbox}%
  \else
    % Put bubbles on every other slide.
    \begin{beamercolorbox}[ht=2.25ex,dp=3.75ex]{section in head/foot}
        \insertnavigation{\paperwidth}
    \end{beamercolorbox}%
  \fi}%

\ifbeamer@unibielefeld@bubbles
    \setbeamertemplate{headline}[IMW theme bubbles]
\fi


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Define frametitle template %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\defbeamertemplate*{frametitle}{IMW theme}
    {%
    \nointerlineskip%
    \vskip-0.1ex%
    \begin{beamercolorbox}[wd=\paperwidth,sep=0.3cm,vmode]{frametitle}
        \vbox{}\vskip-1.25ex%
        \usebeamerfont*{frametitle}\strut\insertframetitle%
        \ifx\insertframesubtitle\@empty%
            \strut\par%
        \else
            \par{\usebeamerfont*{framesubtitle}{\usebeamercolor[fg]{framesubtitle}\strut\insertframesubtitle}\strut\par}%
        \fi%%
        \vskip-0.7ex%
    \end{beamercolorbox}%
}



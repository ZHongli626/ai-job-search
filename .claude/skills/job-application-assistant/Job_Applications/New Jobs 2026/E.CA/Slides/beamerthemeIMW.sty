%% Theme options documentation
%%
%% Font options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% `lelofont': bool [default: true]
%%     If true, sets Lelo as the default font family.
%%
%%
%% Inner theme options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% `sectiontoc' : bool [default: false]
%%     If `sectiontoc' is true, at the beginning of every section the TOC is
%%     repeated with the current section highlighted.
%%
%%
%% `institute' : str {'IMW', 'CUDE', 'BiGSEM'} [default: 'IMW']
%%     Defines the institute or project logo used as `mylogo'. Corresponds to
%%     the folder name inside of the logos/institutes folder.
%%
%%
%% `institutelang' : str {'english', 'german', 'none'} [default: 'none']
%%     Sets the language under the institute or project logo. If 
%%     institutelang=none, the in institute or project logo will be printed 
%%     without text. Corresponds to the end of the picture file name.
%%     Note: If a `mylogo' path if provided, this option is ignored.
%%
%%
%% `department' : str {'none', 'economics', 'mathematics'} [default: 
%%     'economics']}
%%     Defines the department logo used as `logo'. Corresponds to the folder
%%     name inside of the logos/departments folder. 
%%
%%
%% `departmentlang' : str {'english', 'german', 'none'} [default: 'english']
%%     Set the language under the department logo. If departmentlang=none, only
%%     the Universit\"at Bielefeld will be drawn. (Without the colored box)
%%     Corresponds to the end of the picture file name.
%%     Note: If a `logo' path if provided, this option is ignored.
%%
%%
%% `shadow' : bool [default: false]
%%     If `shadow' is true, blocks will have a fuzzy shadow (see `drop fuzzy 
%%     shadow' in the `tcolorbox' package)
%%
%%
%% `rounded' : bool [default: true]
%%     If `rounded' is true, blocks have rounded corners according to the value
%%     in the `\cornerarc' command below. If `rounded' is false, the block
%%     corners are sharp.
%%
%%
%% `blocks' : bool [default: true]
%%     If `blocks' is true, beamer blocks are redefined using the `tcolorbox'
%%     package.
%%
%%
%% Outer theme options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% `bubbles' : bool [default: false]
%%     If true, this option will draw the minipage navigation in the headline.
%%     (Compare for example the `Frankfurt' theme but with colors to blend in
%%     with the frame title and no shadings.)
%%     Note: The headline is not drawn on frames with framenumber 1 (e.g. the
%%           title frame)
%%
%%
%% `CUDE' : bool [default: false]
%%     If true, sets institute=CUDE.
%%     Note: If a `mylogo' path if provided, this boolean is ignored.
%%
%%
%% `BiGSEM' : bool [default: false]
%%     If true, sets institute=BiGSEM.
%%     Note: If a `mylogo' path if provided, this boolean is ignored.
%%     Note: This option is temporarily not implemented!
%%
%%
%% `footerline' : bool [default: true]
%%     If true, a line in the 'structure' color is drawn at 5% of the 
%%     frameheight.
%%
%%
%% `logoinfoot' : bool [default: false]
%%     If true, `logo' will be placed vertiaclly centered at the footer line.
%%     Note: If both `logoinfoot' and `mylogoinfoot' are true, `logoinfoot' is
%%           set to false.
%%     Note: If both `logoinfoot' and `authorinfoot' are true, `logoinfoot' is
%%           set to false.
%%
%%
%% `mylogoinfoot' : bool [default: true]
%%     If true, `mylogo' will be placed vertiaclly centered at the footer line.
%%     Note: If both `logoinfoot' and `mylogoinfoot' are true `logoinfoot' is
%%           set to false.
%%     Note: If both `mylogoinfoot' and `authorinfoot' are true, `logoinfoot' 
%%           is set to false.
%%
%%
%% `authorinfoot' : bool [default: false]
%%     If true, the short version of the author is placed below the footerline.
%%     Note: If both `authorinfoot' and `logoinfoot' or `mylogoinfoot' are
%%           are true, `logoinfoot' or `mylogoinfoot' is set to false.
%%
%%
%% `titleinfoot' : bool [default: false]
%%     If true, the short verion of the title is placed below the footerline.
%%
%%
%% `totalframes' : bool [default: false]
%%     If true, the current framenumber will be drawn the `totalframenumber' in
%%     the format 'x / y'.
%%
%%
%% `smallmargins' : bool [default: false]
%%     If true, the left and right margins are halfed from the default of 10mm
%%     to 5mm.
%%
%%
%% Additional behavior for outer theme:
%%     - The footline is not drawn on frames with framenumber 1 (e.g. the title
%%       frame)
%%     - If both `authorinfoot' and `titleinfoot' are true, the framenumber
%%       (with optional total framenumber) is drawn on the same height as the
%%       other text in the footline.
%%
%%
%% Color theme options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% `invertedframetitle' : bool [default: true]
%%     If true, the frame title and headline have `white' foreground and 
%%     (mixed) `imwblue' background color.
%%
%%
%% `alertred' : bool [default: false]
%%     If true, the alert color is changed to the predefined color `healthred'.
%%
%%
%% `truewhite' : bool [default: false]
%%     If true, redefines the color white to #FFFFFF instead of #F0F0F0.
%%
%%
%% Aggregate options (presets)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% `extended' : bool [default: false]
%%     If true, the folllowing options are set from their default values:
%%     - `mylogoinfoot' -> false
%%     - `authorinfoot' -> true
%%     - `titleinfoot'  -> true
%%     - `totalframes'  -> true
%%     - `bubbles'      -> true
%%     - `sectiontoc'   -> true
%%
%%
%% Other options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% The corner arc of the beamer blocks and itemize blocks can be changed here.
%% For the behavior of this value compare '/tikz/rounded corners' in
%% https://pgf-tikz.github.io/pgf/pgfmanual.pdf
%% Note: The value of the command (probably) needs a unit.
%%
\newcommand{\cornerarc}{0.3mm}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% `mylogo' can be overwritten be providing a path in the below command. The
%% path needs to look like e.g. 'figures/my_example_picture.jpg'. If the file
%% at the provided path exists it will be used. Analogously `logo' can be over-
%% written in a similar command below.
%%
\newcommand{\mylogopath}{}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% If a third logo should be placed on the titlepage, a path can be provided in
%% the `midlogopath' command below.
%% Note: The use of the third logo is not recommened if the frame aspect ratio
%%       is 4:3 or something similar.
%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% Adding additional department or institute or project logos is simple. The
%% process for adding a new institute is described below but departments are
%% analogous. (Note that no department language is equivalent having just the
%% base logo and thus the none language variant can be omitted.)
%%
%% Say we want to add the Example Institute and have logos as .png files on 
%% hand. In this case, we need to create a new folder named 'example' inside of
%% logos/institutes, in which we put the logos and rename them to 
%%     example_logo_{language}.png
%% For the logo without any text we replace {language} with 'none'.
%% Now we can simply call the theme with the option 
%%     institute=example
%% and the desired `institutelang' like the pre-configured institutes.
%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%% Changelog
%% v1.0
%% Main change to beta is the implementation of logo placement.

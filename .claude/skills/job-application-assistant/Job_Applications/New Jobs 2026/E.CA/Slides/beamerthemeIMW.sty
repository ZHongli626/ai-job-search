%%%%%%%%%%%%%%%%%%%%%%%%%
%% Modify `title page` %%
%%%%%%%%%%%%%%%%%%%%%%%%%

\defbeamertemplate*{title page}{IMW theme}[1][]{
  % Put titlegraphic
  \begin{tikzpicture}[remember picture, overlay]
    \draw (current page.north west) node[below right, xshift=0.05\paperwidth, yshift=-0.05\paperheight] {\departmentlogo};
    \draw (current page.north east) node[below left, xshift=-0.05\paperwidth, yshift=-0.05\paperheight] {\institutelogo};
    \ifdefempty{\midlogopath}{}{
      \draw (current page.north) node[below, yshift=-0.05\paperheight] {
        \includegraphics[height=0.12\paperheight]{\midlogopath}
      };
    }
  \end{tikzpicture}
  
  \vbox{}
  \vfill\vfill
  \begingroup
    \centering

    % Put title
    \begin{beamercolorbox}[sep=8pt,center,#1]{title}
    \usebeamerfont{title}\textbf{\inserttitle}\par%
    \ifx\insertsubtitle\@empty%
    \else%
      \vskip0.25em%
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
    \fi%     
    \end{beamercolorbox}

    \vskip1em\par

    % Put Author
    \begin{beamercolorbox}[sep=8pt,center,#1]{author}
      \usebeamerfont{author}\insertauthor
    \end{beamercolorbox}

    % Put institut
    \begin{beamercolorbox}[sep=8pt,center,#1]{institute}
      \usebeamerfont{institute}\insertinstitute
    \end{beamercolorbox}

    % Put date
    \begin{beamercolorbox}[sep=8pt,center,#1]{date}
      \usebeamerfont{date}\insertdate
    \end{beamercolorbox}

  \endgroup
}

\setbeamertemplate{title page}[IMW theme]





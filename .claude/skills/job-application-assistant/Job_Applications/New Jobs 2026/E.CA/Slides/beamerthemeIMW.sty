% Itemize environment
\defbeamertemplate*{itemize item}{IMW theme}{\raise 0.5mm\hbox{
  \begin{tikzpicture}
    \draw[rounded corners=\cornerarc, fill] (0,0) rectangle (0.15,0.15);
  \end{tikzpicture}
}}

\defbeamertemplate*{itemize subitem}{IMW theme small}{\raise 0.5mm\hbox{
  \begin{tikzpicture}
    \draw[rounded corners=\cornerarc, fill] (0,0) rectangle (0.1,0.1);
  \end{tikzpicture}
}}


\setbeamertemplate{itemize item}[IMW theme]
\setbeamertemplate{itemize subitem}[IMW theme small]


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Modification of `tableofcontents` %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\defbeamertemplate*{section in toc}{IMW theme}{
  \leavevmode\leftskip=3ex
  \llap{
    \begin{tikzpicture}
      % Scale the node to fit the text height
      \draw (0,0) node [inner ysep=0em, scale=1.13] {
      \usebeamerfont*{section number projected}
      \usebeamercolor*[bg]{section number projected}
      \inserttocsectionnumber.};
    \end{tikzpicture}
  }
  \kern1ex
  \inserttocsection\par
}

% Disallow the printing of subsections in the TOC
\defbeamertemplate*{subsection in toc}{IMW theme}{}

\setbeamertemplate{section in toc}[IMW theme]
\setbeamertemplate{subsection in toc}[IMW theme]

% Print currentsection if sectiontoc is true
\ifbeamer@unibielefeld@sectiontoc
    \AtBeginSection{
        \begin{frame}<beamer>
            \frametitle{Outline}
